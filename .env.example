# Copy this file to .env and fill it in. Never commit .env.
# Your site without https://, e.g. stepcost-lab.atlassian.net
ATLASSIAN_SITE=your-site.atlassian.net
# The email you log in to Atlassian with
ATLASSIAN_EMAIL=you@example.com
# Create at Atlassian account settings > Security > API tokens
ATLASSIAN_API_TOKEN=paste-token-here
